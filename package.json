{
  "name": "business-knowledge-workbench",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write web tests/browser scripts/*.mjs public/*.js public/*.html *.json *.ts *.html",
    "format:check": "prettier --check web tests/browser scripts/*.mjs public/*.js public/*.html *.json *.ts *.html",
    "docs": "python scripts/code_index.py",
    "docs:check": "python scripts/code_index.py --check",
    "verify": "npm run typecheck && npm run build && npm run test",
    "desktop": "electron .",
    "package": "electron-builder",
    "test:private": "playwright test --config playwright.private.config.ts",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "vite": "8.3.1",
    "typescript": "6.0.3",
    "prettier": "3.9.8",
    "docx": "9.5.1",
    "electron": "44.5.0",
    "electron-builder": "26.15.3"
  },
  "author": "Jason Stys",
  "description": "Private local business documents, product evidence and reporting workspace",
  "main": "desktop/main.cjs",
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "dev.jasonstys.businessknowledge",
    "productName": "Business Knowledge Workbench",
    "directories": {
      "output": "release/installers"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "ui"
      },
      {
        "from": "release/service",
        "to": "service"
      },
      {
        "from": "release/notices",
        "to": "notices"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  }
}
